{
  "$schema": "https://altinn.studio/designer/app-dist/9.0.0/schemas/json/layout/layout.schema.v1.json",
  "data": {
    "layout": [
      {
        "id": "uploadWithoutDataType",
        "type": "FileUpload",
        "textResourceBindings": {
          "title": "leftovers.uploadWithoutDataType.title"
        },
        "maxFileSizeInMB": 25,
        "maxNumberOfAttachments": 1,
        "minNumberOfAttachments": 0,
        "displayMode": "list"
      },
      {
        "id": "leftovers-navigation",
        "type": "NavigationButtons",
        "showBackButton": true,
        "textResourceBindings": {}
      }
    ]
  }
}
