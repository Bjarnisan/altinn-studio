{
  "$schema": "https://altinn.studio/designer/app-dist/9.0.0/schemas/json/layout/layout.schema.v1.json",
  "data": {
    "layout": [
      {
        "id": "details-name",
        "type": "Input",
        "dataModelBindings": {
          "simpleBinding": "name"
        },
        "textResourceBindings": {
          "title": "details.name.title"
        }
      },
      {
        "id": "receipts",
        "type": "FileUpload",
        "textResourceBindings": {
          "title": "details.receipts.title"
        },
        "maxFileSizeInMB": 25,
        "maxNumberOfAttachments": 1,
        "minNumberOfAttachments": 1,
        "displayMode": "list"
      },
      {
        "id": "details-navigation",
        "type": "NavigationButtons",
        "showBackButton": true,
        "textResourceBindings": {}
      }
    ]
  }
}
